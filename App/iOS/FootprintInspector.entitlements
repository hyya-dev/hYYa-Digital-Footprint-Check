<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the widget, holding only the score and the time of the last check. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.hyya.footprintinspector</string>
	</array>
	<!-- Declared Age Range: asks Apple's age-range sheet only where a law requires it. The answer
	     is never stored or sent. -->
	<key>com.apple.developer.declared-age-range</key>
	<true/>
	<!-- Lets the app read Apple's nudity-blurring setting, to show the user what any app with this
	     capability learns. It analyses no content. -->
	<key>com.apple.developer.sensitivecontentanalysis.client</key>
	<array>
		<string>analysis</string>
	</array>
</dict>
</plist>
